{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "python -m uvicorn app.main:app --reload --port 8000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ],
  "outputDirectory": "frontend",
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  },
  "env": {
    "PLAGIFY_DATA_DIR": "/tmp/plagify_data"
  }
}