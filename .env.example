PLAGIFY_SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Supabase (optional — falls back to local SQLite if unset)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=original-documents

# AI detection (optional APIs; lmscan works offline if installed)
AI_DETECTION_PROVIDER=auto
GPTZERO_API_KEY=
SAPLING_API_KEY=

MAX_UPLOAD_BYTES=26214400
