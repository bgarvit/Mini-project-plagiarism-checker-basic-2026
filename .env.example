# PLAGIFY Environment Variables
# Copy this file to .env and fill in your values
# For Garvit deployment, add these in the Garvit Dashboard > Settings > Environment Variables

# Required: Secret key for JWT tokens (generate with: openssl rand -hex 32)
PLAGIFY_SECRET_KEY=your-super-secret-key-change-in-production

# Optional: Google OAuth Client ID (from Google Cloud Console)
# Required for Google Sign-In on the frontend
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Supabase Configuration (for persistent document storage)
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=original-documents

# Optional: AI Detection APIs (for enhanced AI detection)
# GPTZero: https://gptzero.me/api
GPTZERO_API_KEY=
# Sapling: https://sapling.ai/api
SAPLING_API_KEY=

# Optional: AI Detection Provider (auto, lmscan, gptzero, sapling)
AI_DETECTION_PROVIDER=auto

# Optional: CORS Origins (comma-separated)
# Add your Garvit deployment URL and custom domains
CORS_ORIGINS=https://your-app.garvit.app,https://your-custom-domain.com

# Optional: File Upload Limits
MAX_UPLOAD_BYTES=26214400

# Optional: Token Expiry (minutes, default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Garvit-specific (auto-detected, don't set manually)
# GARVIT=1
# GARVIT_ENV=production